__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
dist/

/tmp/

server/bin/
server/data/
# Embedded admin UI from `pnpm build` (Makefile copies frontend/dist here).
# Keep a committed stub index.html so `go build` / `go test` work without Node.
# Un-ignore the directory first — git cannot re-include a file under an ignored parent.
server/cmd/server/web/**
!server/cmd/server/web/
!server/cmd/server/web/index.html
client/data/
# Piper ONNX voice cache (downloaded by `make download-tts-models`; not cleared by `make clean`).
client/tts/**
!client/tts/
!client/tts/.gitkeep
# NLTK corpora for Windows piper-plus English (g2p_en); fetched by download_nltk_data.py.
client/nltk_data/**
!client/nltk_data/
!client/nltk_data/.gitkeep
build/
bin/
# Generated Windows PE icon objects (rebuilt by make windows-icon).
**/rsrc_windows_*.syso
**/winres/
